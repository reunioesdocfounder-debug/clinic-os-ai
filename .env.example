# ============================================================================
# ClinicOS AI — Variáveis de ambiente
#
# Copie este arquivo para `.env.local` (desenvolvimento) e preencha com os
# valores do seu projeto Supabase (Project Settings > API).
#
# No Vercel: Project Settings > Environment Variables — configurar as 3
# variáveis abaixo marcadas como "obrigatória no Vercel".
# ============================================================================

# URL do projeto (Project Settings > API > Project URL).
# Obrigatória no Vercel.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon (Project Settings > API > Project API keys > anon public).
# Exposta ao navegador — protegida pelas políticas de RLS.
# Obrigatória no Vercel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role (Project Settings > API > Project API keys > service_role).
# NUNCA exponha esta chave no client. Usada apenas em código server-side
# (lib/supabase/admin.ts).
# Obrigatória no Vercel — configurar SEM o prefixo NEXT_PUBLIC_ (server-only).
SUPABASE_SERVICE_ROLE_KEY=

# Chave publishable (formato novo da API do Supabase) — não usada pelo
# código atual (lib/supabase usa a anon key acima), mantida para referência
# futura. Não é necessária no Vercel.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Senha do usuário "postgres" do banco (Project Settings > Database).
# Usada apenas por scripts administrativos locais (ex.: aplicar migrações
# via conexão direta). NUNCA usar no client nem versionar. Não é necessária
# no Vercel.
SUPABASE_DB_PASSWORD=
